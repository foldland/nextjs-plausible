{
  "name": "@foldland/nextjs-plausible-meta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm lint:check && pnpm format:check && pnpm typecheck",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "format:write": "biome format --write",
    "lint:check": "biome check --formatter-enabled=false --linter-enabled=true --assist-enabled=true",
    "lint:write": "pnpm lint:check --write",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@foldland/biome-configs": "1.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  }
}
